instance.set_result("");
instance.set_scroll(-1000.);
slint_testing::send_mouse_click(&instance, 5., 5.);
assert_eq(instance.get_result(), "(10)(11)(12)");
instance.set_result("");
instance.set_scroll(-850.);
slint_testing::send_mouse_click(&instance, 5., 5.);
assert_eq(instance.get_result(), "(9)(8)");
