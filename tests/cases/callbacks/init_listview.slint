// Verify that the init callback is invoked in the correct order.
//
// With the repeater instance pool, `init` fires once per *physical* instance:
// rows scrolling into view reuse instances parked when other rows scrolled
// out, and reused instances do not re-fire `init` (same semantics as
// recycled instances on model reset). Only genuinely new instances —
// growing past the pool's high-water mark — fire it.


import { ListView } from "std-widgets.slint";
export component TestCase inherits Window {
    width: 300px;
    height: 300px;
    in-out property <string> result;
    lv := ListView {
        for idx in 30 : Rectangle {
            height: 100px;
            init => { result += "(" + idx + ")"; }
        }
    }
    in-out property scroll <=> lv.viewport-y;
}

/*
```rust
let instance = TestCase::new().unwrap();

slint_testing::send_mouse_click(&instance, 5., 5.);
assert_eq!(instance.get_result(), "(0)(1)(2)");
instance.set_result("".into());
// Rows 3 and 4 scroll in before anything was parked: fresh instances, init fires.
instance.set_scroll(-150.);
slint_testing::send_mouse_click(&instance, 5., 5.);
assert_eq!(instance.get_result(), "(3)(4)");
instance.set_result("".into());
// Random seek: all previous instances are parked and reused for rows 10-12,
// so no init fires.
instance.set_scroll(-1000.);
slint_testing::send_mouse_click(&instance, 5., 5.);
assert_eq!(instance.get_result(), "");
instance.set_result("".into());
// Scrolling back up reuses parked instances for rows 9 and 8 as well.
instance.set_scroll(-850.);
slint_testing::send_mouse_click(&instance, 5., 5.);
assert_eq!(instance.get_result(), "");


```

